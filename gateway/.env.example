# Local MQTT broker. Use the broker PC's LAN address in firmware settings.
GATEWAY_MQTT_HOST=127.0.0.1
GATEWAY_MQTT_PORT=1883
GATEWAY_MQTT_USERNAME=
GATEWAY_MQTT_PASSWORD=

# Cloud MQTT endpoint and device token supplied by Member C.
COREIOT_MQTT_URL=mqtts://your-coreiot-host.example:8883
GATEWAY_COREIOT_DEVICE_ID=classroom-01
GATEWAY_COREIOT_DEVICE_TOKEN=
# COREIOT_MQTT_CA_FILE=C:/path/to/coreiot-ca.pem
